{
  "name": "FinGuard - Financial Surveillance",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "FinGuard Streamlit Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && python pipeline_setup.py",
  "postStartCommand": "streamlit run app.py --server.port 8501 --server.headless true"
}
